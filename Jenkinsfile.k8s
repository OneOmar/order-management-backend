
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ghcr.io/oneomar/order-management-backend'
        IMAGE_TAG = "k8s-${BUILD_NUMBER}"
        K8S_NAMESPACE = 'order-management'
        K8S_SERVER = 'https://127.0.0.1:6443'
        K8S_CA = '/etc/jenkins/k3s-server-ca.crt'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    set -eu
                    test -f mvnw
                    docker --version
                    kubectl version --client
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh '''
                    set -eu
                    chmod +x mvnw
                    ./mvnw -B clean package -DskipTests
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    set -eu
                    docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" .
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-credentials',
                        usernameVariable: 'GHCR_USER',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Publish the image to GHCR.
                        echo "$GHCR_TOKEN" | docker login ghcr.io \
                          --username "$GHCR_USER" --password-stdin
                        docker push "${IMAGE_NAME}:${IMAGE_TAG}"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k3s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
			export KUBECONFIG=/dev/null

                        # Update the application image.
                        kubectl \
                          --server="${K8S_SERVER}" \
                          --certificate-authority="${K8S_CA}" \
                          --token="$K8S_TOKEN" \
                          set image deployment/order-app \
                          order-app="${IMAGE_NAME}:${IMAGE_TAG}" \
                          -n "${K8S_NAMESPACE}"

                        # Wait for the rollout to complete.
                        kubectl \
                          --server="${K8S_SERVER}" \
                          --certificate-authority="${K8S_CA}" \
                          --token="$K8S_TOKEN" \
                          rollout status deployment/order-app \
                          -n "${K8S_NAMESPACE}" \
                          --timeout=180s
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k3s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
			export KUBECONFIG=/dev/null

                        # Check application health from inside the cluster.
                        kubectl \
                          --server="${K8S_SERVER}" \
                          --certificate-authority="${K8S_CA}" \
                          --token="$K8S_TOKEN" \
                          run "test-api-${BUILD_NUMBER}" \
                          --namespace="${K8S_NAMESPACE}" \
                          --rm -i \
                          --restart=Never \
                          --image=curlimages/curl:8.12.1 \
                          --command -- sh -c '
                            for i in $(seq 1 12); do
                              if curl -fsS \
                                http://order-app:8080/actuator/health; then
                                echo "Health check passed."
                                exit 0
                              fi

                              echo "Attempt $i/12 failed."
                              sleep 5
                            done

                            echo "Health check failed."
                            exit 1
                          '
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment successful: ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo 'Pipeline failed. Rolling back application deployment.'

            withCredentials([
                string(
                    credentialsId: 'k3s-jenkins-token',
                    variable: 'K8S_TOKEN'
                )
            ]) {
                sh '''
                    set -eu
                    set +x
                    export KUBECONFIG=/dev/null

                    # Restore the previous deployment revision.
                    kubectl \
                      --server="${K8S_SERVER}" \
                      --certificate-authority="${K8S_CA}" \
                      --token="$K8S_TOKEN" \
                      rollout undo deployment/order-app \
                      -n "${K8S_NAMESPACE}"

                    # Wait for the rollback to finish.
                    kubectl \
                      --server="${K8S_SERVER}" \
                      --certificate-authority="${K8S_CA}" \
                      --token="$K8S_TOKEN" \
                      rollout status deployment/order-app \
                      -n "${K8S_NAMESPACE}" \
                      --timeout=180s
                '''
            }
        }

        always {
            // Close the GHCR session.
            sh 'docker logout ghcr.io >/dev/null 2>&1 || true'
        }
    }

}

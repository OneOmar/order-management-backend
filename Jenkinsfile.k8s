
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ghcr.io/oneomar/order-management-backend'
        IMAGE_TAG = "k8s-${BUILD_NUMBER}"
        K8S_NAMESPACE = 'order-management'
        K8S_SERVER = 'https://127.0.0.1:6443'
        K8S_CA = '/etc/jenkins/k3s-server-ca.crt'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Prepare') {
            steps {
                sh '''
                    set -eu
                    test -f mvnw
                    docker --version
                    kubectl version --client
                '''
            }
        }

        stage('Build JAR') {
            steps {
                sh '''
                    set -eu
                    chmod +x mvnw
                    ./mvnw -B clean package -DskipTests
                '''
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    set -eu
                    docker build -t "${IMAGE_NAME}:${IMAGE_TAG}" .
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-credentials',
                        usernameVariable: 'GHCR_USER',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Log in to GHCR and push the image.
                        echo "$GHCR_TOKEN" | docker login ghcr.io \
                          --username "$GHCR_USER" \
                          --password-stdin

                        docker push "${IMAGE_NAME}:${IMAGE_TAG}"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k3s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        # Update the application image.
                        kubectl \
                          --server="${K8S_SERVER}" \
                          --certificate-authority="${K8S_CA}" \
                          --token="$K8S_TOKEN" \
                          set image deployment/order-app \
                          order-app="${IMAGE_NAME}:${IMAGE_TAG}" \
                          -n "${K8S_NAMESPACE}"

                        # Wait for the rollout to complete.
                        kubectl \
                          --server="${K8S_SERVER}" \
                          --certificate-authority="${K8S_CA}" \
                          --token="$K8S_TOKEN" \
                          rollout status deployment/order-app \
                          -n "${K8S_NAMESPACE}" \
                          --timeout=180s
                    '''
                }
            }
        }

        // Public health check is intentionally skipped for now.
    }

    post {
        success {
            echo "Deployment successful: ${IMAGE_NAME}:${IMAGE_TAG}"
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins logs.'
        }

        always {
            // Close the GHCR session.
            sh 'docker logout ghcr.io >/dev/null 2>&1 || true'
        }
    }
}
